# ============================================
# 输出文件配置区
# ============================================
# 通用数据存储子目录（相对于 data/，可为空，不允许绝对路径和场景保留名）
IP_STORAGE_DIR=
# 通用数据存储文件名（用于数据文件命名前缀）
IP_STORAGE_NAME=ip_data

# ============================================
# API Key / Cookie 凭证配置区
# ============================================
# Fofa API Key
IP_FOFA_API_KEY=your_fofa_api_key_here
# IPInfo Access Token
IP_IPINFO_ACCESS_TOKEN=your_ipinfo_access_token_here
# 爱站网 Cookie（浏览器登录后获取）
IP_AIZHAN_COOKIE=your_aizhan_cookie_here
# 站长之家 Cookie（可选，有 Cookie 可查更多信息）
IP_CHINAZ_COOKIE=
# ZoomEye API Key
IP_ZOOMEYE_API_KEY=

# ============================================
# 查询间隔与超时配置区
# ============================================
# RDNS 查询超时（秒）
IP_RDNS_QUERY_TIMEOUT=1.5
# RDNS 查询间隔（秒）
IP_RDNS_QUERY_DELAY=0.1
# IPInfo 查询超时（秒）
IP_IPINFO_QUERY_TIMEOUT=30
# IPInfo 查询间隔（秒）
IP_IPINFO_QUERY_DELAY=1.2
# Fofa 查询超时（秒）
IP_FOFA_QUERY_TIMEOUT=30
# Fofa 查询间隔（秒）
IP_FOFA_QUERY_DELAY=2.0
# 爱站查询超时（秒）
IP_AIZHAN_QUERY_TIMEOUT=15
# 爱站查询间隔（秒）
IP_AIZHAN_QUERY_DELAY=2.0
# 站长之家查询超时（秒）
IP_CHINAZ_QUERY_TIMEOUT=15
# 站长之家查询间隔（秒）
IP_CHINAZ_QUERY_DELAY=2.0
# Whois 查询超时（秒）
IP_WHOIS_QUERY_TIMEOUT=2
# Whois 查询间隔（秒）
IP_WHOIS_QUERY_DELAY=0.5
# SSL 证书获取端口
IP_SSL_CERT_PORT=443
# SSL 连接超时（秒）
IP_SSL_CERT_TIMEOUT=5
# SSL OpenSSL 子进程超时（秒）
IP_SSL_CERT_OPENSSL_TIMEOUT=10
# SSL 证书查询间隔（秒）
IP_SSL_CERT_QUERY_DELAY=0.5
# ZoomEye 查询超时（秒）
IP_ZOOMEYE_QUERY_TIMEOUT=30
# ZoomEye 查询间隔（秒）
IP_ZOOMEYE_QUERY_DELAY=2.0
# nmap 可执行文件路径
IP_PORT_SCAN_NMAP_PATH=nmap
# 单 IP 端口扫描超时（秒）
IP_PORT_SCAN_TIMEOUT=90
# 端口列表文件路径
IP_PORT_SCAN_PORT_LIST=config/port_scan/top1000.txt
